{
  "name": "off-the-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-flights && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-flights": "tsx scripts/check-flights.ts",
    "priors": "tsx scripts/priors.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "relaunch": "tsx --env-file-if-exists=.env.local scripts/relaunch.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
