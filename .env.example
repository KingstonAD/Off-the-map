# Supabase (server only — never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown at the bottom of the share text, e.g. offthemap.app
NEXT_PUBLIC_SITE_DOMAIN=

